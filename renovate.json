{
  "extends": ["schedule:weekly"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "automergeType": "branch",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    }
  ]
}
